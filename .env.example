# Use the project URL and publishable key from Supabase > Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# When no Supabase credentials are present, the UI runs with non-real sample data.
# Set to false only after a real Supabase project and Auth users have been configured.
RNMCOM_DEMO_MODE=true